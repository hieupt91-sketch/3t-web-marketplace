# Copy to .env (git-ignored) and adjust. Development defaults work without a .env file.
# Never put real secrets in this file.
# Staging (Docker + Cloudflare Tunnel) uses deploy/.env.example instead; see deploy/README.md.
APP_ENV=development
DATABASE_URL=postgres://marketplace@127.0.0.1:55432/marketplace
# Portal/API origin as seen by the browser (same origin; Next.js proxies /api in development).
PORTAL_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:4000
# Preview origin must be a different registrable domain from the portal in production (ADR-005).
PREVIEW_ORIGIN_TEMPLATE=http://{label}.preview.localhost:4100
PREVIEW_BASE_DOMAIN=preview.localhost
PREVIEW_INTERNAL_URL=http://127.0.0.1:4100
COOKIE_SECURE=false
# file = write emails to runtime-data/dev-mail (development only); disabled = no email provider.
MAIL_TRANSPORT=file
# Screenshots need a Chromium binary; leave off if none is installed.
SCREENSHOTS=off
CHROMIUM_PATH=
# Sandbox payment (mock). A real provider replaces this at the integration milestone.
PLATFORM_CURRENCY=VND
MOCK_PAYMENT_SECRET=dev-mock-payment-secret
PAYMENT_WINDOW_MINUTES=30
