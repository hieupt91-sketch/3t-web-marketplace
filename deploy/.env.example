# Staging environment. Copy to .env in this directory (deploy/.env) and fill
# in the real values. Never commit a real .env file.
# Generate the secrets with: openssl rand -hex 32
APP_ENV=production
DB_PASSWORD=change-me-to-a-long-random-password

# The public URL visitors use, via the Cloudflare Tunnel. This MUST match the
# tunnel hostname exactly, or logins and form posts fail with origin_mismatch.
PORTAL_ORIGIN=https://webmaket.com
# Demo previews are served by PATH on a single-label subdomain
# (https://preview.webmaket.com/<label>/): the free Cloudflare Universal
# certificate only covers one subdomain level, so <label>.preview.webmaket.com
# would get no certificate at all.
PREVIEW_ORIGIN_TEMPLATE=https://preview.webmaket.com/{label}
PREVIEW_BASE_DOMAIN=preview.webmaket.com
# Hosted customer sites are served by the site router (:4200) under the
# portal's own domain, one label deep: https://<subdomain>.webmaket.com.
# The api/worker refuse to start in production without both values.
SITE_BASE_DOMAIN=webmaket.com
SITE_ORIGIN_TEMPLATE=https://{label}.webmaket.com
COOKIE_SECURE=true

# Mail stays disabled until a provider is configured (no password-reset
# emails are sent). To enable real mail: set MAIL_TRANSPORT=resend here
# and save the Resend API key in Admin → Settings → Email.
MAIL_TRANSPORT=disabled
SCREENSHOTS=off
PLATFORM_CURRENCY=VND
PAYMENT_WINDOW_MINUTES=15

# Required in production mode; use a different random value for each.
MOCK_PAYMENT_SECRET=change-me-random-32-bytes-hex
PARTNER_LINK_SECRET=change-me-random-32-bytes-hex
PARTNER_WEBHOOK_KEY=change-me-random-32-bytes-hex
MFA_KEY=change-me-random-32-bytes-hex
# Sandbox Phase 1 (audit C-01): shared token between the worker and the
# site-runner service — the ONLY credential the runner ever holds. Use a
# different random value for each environment; the runner refuses to
# start without it and the worker requires it whenever
# RUNTIME_AGENT_URL is set.
RUNNER_TOKEN=change-me-random-32-bytes-hex
GITHUB_WEBHOOK_SECRET=
