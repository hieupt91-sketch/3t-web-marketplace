{
  "schemaVersion": 1,
  "slug": "node-service-admin-fixture",
  "version": "1.0.0",
  "name": {
    "vi": "Dịch vụ Node có quản trị (kiểm thử)",
    "en": "Node service with admin (fixture)"
  },
  "summary": {
    "vi": "Kiểm tra tài khoản quản trị demo cho phiên demo.",
    "en": "Tests the demo admin account for demo sessions."
  },
  "adapter": "node-http",
  "projectRoot": ".",
  "runtime": {
    "start": [
      "node",
      "server.mjs"
    ],
    "healthPath": "/__health",
    "port": 3000,
    "writePaths": [
      "/data"
    ]
  },
  "database": {
    "engine": "none"
  },
  "demo": {
    "mode": "isolatedAdmin",
    "ttlHours": 2
  },
  "locales": {
    "default": "vi",
    "supported": [
      "vi"
    ],
    "contentMode": "runtime"
  },
  "capabilities": [
    "admin"
  ],
  "env": [],
  "export": {
    "modes": [
      "hosted"
    ],
    "sourceRoot": "."
  },
  "build": {
    "script": "build",
    "outputDir": "dist",
    "toolchain": "node22",
    "packageManager": "npm",
    "lockfile": "package-lock.json"
  }
}
