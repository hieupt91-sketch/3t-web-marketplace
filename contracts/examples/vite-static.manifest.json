{
  "schemaVersion": 1,
  "slug": "vite-static-example",
  "version": "1.0.0",
  "name": {
    "vi": "Mẫu kiểm thử landing",
    "en": "Landing test fixture"
  },
  "summary": {
    "vi": "Dữ liệu minh họa kiểm tra nhận diện HTML.",
    "en": "A fixture for validating HTML import."
  },
  "adapter": "vite-static",
  "projectRoot": ".",
  "runtime": {
    "entry": "index.html",
    "spaFallback": false
  },
  "database": {
    "engine": "none"
  },
  "demo": {
    "mode": "publicReadonly",
    "ttlHours": 24
  },
  "locales": {
    "default": "vi",
    "supported": [
      "vi"
    ],
    "contentMode": "static"
  },
  "capabilities": [
    "landing"
  ],
  "env": [],
  "export": {
    "modes": [
      "selfhost",
      "hosted"
    ],
    "sourceRoot": "."
  },
  "build": {
    "script": "build",
    "outputDir": "dist",
    "toolchain": "node-lts-approved",
    "packageManager": "npm",
    "lockfile": "package-lock.json"
  }
}
